# Bu değerleri .env.local'e kopyalayın — .env.local git'e girmiyor.
# Vercel'de aynı değişkenler Production ve Preview ortamlarına girilecek.

# --- Site adresi ------------------------------------------------------------
# Canonical'lar, sitemap, robots ve JSON-LD bunu kullanıyor. Sonunda eğik
# çizgi yok. Yerelde boş bırakılırsa http://localhost:3000 varsayılıyor.
NEXT_PUBLIC_SITE_URL=https://lombre.temnyy.dev

# --- Sanity -----------------------------------------------------------------
# Journal içeriği buradan geliyor; stüdyo /admin altında gömülü.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- İletişim formunun mail ucu (src/app/api/contact/route.js) --------------
# Üçü de yoksa form 503 dönüyor ve sunucu günlüğüne eksik olanı yazıyor;
# sessizce "gönderildi" demiyor.

# https://resend.com/api-keys
RESEND_API_KEY=

# Mesajların düşeceği kutu.
CONTACT_TO=

# Gönderen adresi. Resend'de doğrulanmış bir alan adına ait olmalı.
# Kesme işareti düz olsun (') — tipografik olan (’) başlıkta kodlanmıyor.
CONTACT_FROM=L'Ombre <lombre@send.temnyy.dev>
